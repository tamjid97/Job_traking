generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  ARCHIVED
}

model Job {
  id              String    @id @default(cuid())
  date            String?
  companyName     String
  position        String
  resumeDrive     String?
  jobNature       String?
  jobType         String?
  companyLocation String?
  jobLink         String?
  status          JobStatus @default(APPLIED)
  howApplied      String?
  comments        String?
  salary          String?
  location        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}